# App
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NODE_ENV=production

# Auth
ADMIN_PASSWORD=your-strong-password-here
SESSION_SECRET=your-32-char-min-secret-key-change-me

# Database (use PostgreSQL for production)
# Supabase: postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres
# Neon: postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/db
DATABASE_URL="postgresql://user:pass@host:5432/db"

# Storage - Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=manga-tl
R2_PUBLIC_URL=https://pub-xxx.r2.dev  # or custom domain

# OCR API (choose one)
# Option A: Manga-OCR hosted API (your own or third-party)
OCR_API_URL=https://ocr.your-domain.com
OCR_API_KEY=your-ocr-api-key
OCR_ENABLED=true

# Option B: Use external OCR API (Google Vision, AWS Textract, etc.)
# GOOGLE_VISION_API_KEY=xxx
# AWS_TEXTRACT_KEY=xxx

# MTL API (Machine Translation) - choose one
# Option A: DeepL (best quality)
MTL_PROVIDER=deepl
DEEPL_API_KEY=your-deepl-api-key
DEEPL_API_URL=https://api-free.deepl.com  # or api.deepl.com for pro

# Option B: LibreTranslate hosted
# MTL_PROVIDER=libretranslate
# LIBRETRANSLATE_URL=https://libretranslate.your-domain.com
# LIBRETRANSLATE_API_KEY=your-api-key

# Option C: Google Translate
# MTL_PROVIDER=google
# GOOGLE_TRANSLATE_API_KEY=your-api-key

# Option D: Generic OpenAI-compatible (OpenRouter, Together, etc.)
# MTL_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# OPENAI_API_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Feature flags
MTL_ENABLED=true
