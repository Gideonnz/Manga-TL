# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Auth (simple password)
ADMIN_PASSWORD=changeme123
SESSION_SECRET=your-super-secret-key-change-in-production-min-32-chars

# Database (SQLite local)
DATABASE_URL="file:./data/manga-tl.db"

# Storage (local filesystem)
UPLOAD_DIR=./data/uploads

# OCR (Manga-OCR Python service)
OCR_API_URL=http://localhost:8001
OCR_ENABLED=true

# MTL (Ollama local)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
MTL_ENABLED=true

# Alternative: LibreTranslate
LIBRETRANSLATE_URL=http://localhost:5000
